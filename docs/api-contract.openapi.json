  "components": {
    "schemas": {
      "Command": {
        "properties": {
          "action": {
            "type": "string",
            "enum": ["pause", "resume", "cycle"],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action"],
        "title": "Command"
      },
      "Detection": {
        "properties": {
          "residue": {
            "type": "string",
            "maxLength": 160,
            "title": "Residue"
          },
          "shortName": {
            "type": "string",
            "maxLength": 40,
            "title": "Shortname"
          },
          "category": {
            "type": "string",
            "enum": ["plastic", "cardboard", "aluminum"],
            "title": "Category"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "pixel": {
            "$ref": "#/components/schemas/Position"
          },
          "offsetMm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetMm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Position"
              },
              {
                "type": "null"
              }
            ]
          },
          "destination": {
            "type": "string",
            "maxLength": 160,
            "title": "Destination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "residue",
          "shortName",
          "category",
          "confidence",
          "pixel",
          "offsetMm",
          "targetMm",
          "destination"
        ],
        "title": "Detection"
      },
      "Equipment": {
        "properties": {
          "id": {
            "type": "string",
            "enum": ["camera", "yolo", "robot", "gripper", "planner"],
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": ["online", "offline", "unknown"],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "status"],
        "title": "Equipment"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
