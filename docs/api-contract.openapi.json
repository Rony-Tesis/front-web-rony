            "title": "Z"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["x", "y", "z"],
        "title": "RobotPosition"
      },
      "RobotState": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "state": {
            "type": "string",
            "enum": [
              "connecting",
              "idle",
              "preparing",
              "waiting",
              "countdown",
              "moving",
              "holding",
              "cancelled",
              "fault",
              "resetting"
            ],
            "title": "State"
          },
          "stepLabel": {
            "type": "string",
            "maxLength": 200,
            "title": "Steplabel"
          },
          "autoEnabled": {
            "type": "boolean",
            "title": "Autoenabled"
          },
          "cycleActive": {
            "type": "boolean",
            "title": "Cycleactive"
          },
          "holdingObject": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Holdingobject"
          },
          "completedGrasps": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Completedgrasps"
          },
          "reportedPosition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RobotPosition"
              },
              {
                "type": "null"
              }
            ]
          },
          "gripperAngle": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Gripperangle"
          },
          "telemetryAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Telemetryat"
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "connected",
          "state",
          "stepLabel",
          "autoEnabled",
          "cycleActive",
          "holdingObject",
          "completedGrasps",
          "reportedPosition",
          "telemetryAt",
          "error"
        ],
        "title": "RobotState"
      },
      "SimulationState": {
        "properties": {
          "paused": {
            "type": "boolean",
            "title": "Paused"
          },
          "cycleActive": {
            "type": "boolean",
            "title": "Cycleactive"
          },
          "stableFrames": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stableframes"
          },
          "requiredStableFrames": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Requiredstableframes"
          },
          "targetReady": {
            "type": "boolean",
            "title": "Targetready"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "paused",
          "cycleActive",
          "stableFrames",
          "requiredStableFrames",
          "targetReady"
        ],
        "title": "SimulationState"
      },
      "Snapshot": {
        "properties": {
          "experimentalMode": {
            "type": "string",
            "enum": ["optimized", "baseline"],
            "title": "Experimentalmode"
          },
          "updatedAt": {
            "type": "string",
            "title": "Updatedat"
          },
          "sourceMode": {
            "type": "string",
            "enum": ["simulation", "live"],
            "title": "Sourcemode"
          },
          "motionMode": {
            "type": "string",
            "enum": ["simulation", "physical"],
            "title": "Motionmode"
          },
          "telemetryTransport": {
            "type": "string",
            "const": "sse",
            "title": "Telemetrytransport",
            "default": "sse"
          },
          "robotState": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RobotState"
              },
              {
                "type": "null"
              }
            ]
          },
          "cameraTransport": {
            "type": "string",
            "const": "mjpeg",
            "title": "Cameratransport"
          },
          "simulationState": {
            "$ref": "#/components/schemas/SimulationState"
          },
          "detection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Detection"
              },
              {
                "type": "null"
              }
            ]
          },
          "targetDetection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Detection"
              },
              {
                "type": "null"
              }
            ]
          },
          "process": {
            "$ref": "#/components/schemas/Process"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Operations"
          },
          "equipment": {
            "items": {
              "$ref": "#/components/schemas/Equipment"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Equipment"
          },
          "framesPerSecond": {
            "type": "number",
            "maximum": 240.0,
            "minimum": 0.0,
            "title": "Framespersecond"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "experimentalMode",
          "updatedAt",
          "sourceMode",
          "motionMode",
          "cameraTransport",
          "simulationState",
          "detection",
          "targetDetection",
          "process",
          "summary",
          "operations",
          "equipment",
          "framesPerSecond"
        ],
        "title": "Snapshot"
      },
      "Summary": {
        "properties": {
          "processedToday": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Processedtoday"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "successful": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Successful"
          },
          "failed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Failed"
          },
          "averageDurationMs": {
            "type": "number",
            "minimum": 0.0,
            "title": "Averagedurationms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["processedToday", "total", "successful", "failed", "averageDurationMs"],
        "title": "Summary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "rony_session"
      },
      "bearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
