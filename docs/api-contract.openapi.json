{
  "openapi": "3.1.0",
  "info": {
    "title": "Rony cámara y JetMax",
    "description": "API Spring Boot compatible con Angular. SSE/MJPEG y control físico asíncrono. El token es opcional en configuración local.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/simulation/commands": {
      "post": {
        "tags": ["command-controller"],
        "summary": "Pausar, reanudar o ejecutar un ciclo virtual",
        "operationId": "virtual",
        "parameters": [
          {
            "name": "X-Rony-Control",
            "in": "header",
            "description": "Valor obligatorio: 1",
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VirtualCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/session": {
      "post": {
        "tags": ["session-controller"],
        "summary": "Validar el token configurado y crear una cookie HttpOnly por una hora",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-Rony-Control",
            "in": "header",
            "description": "Valor obligatorio: 1",
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/robot/commands": {
      "post": {
        "tags": ["command-controller"],
        "summary": "Solicitar activar, cancelar o resetear el JetMax",
        "description": "200 confirma aceptación, no fin del movimiento. Reset vuelve a HOME y abre la pinza; cancel espera el tramo en curso.",
        "operationId": "physical",
        "parameters": [
          {
            "name": "X-Rony-Control",
            "in": "header",
            "description": "Valor obligatorio: 1",
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhysicalCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "403": {
            "description": "Cabecera u origen inválido",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "409": {
            "description": "Modo o estado incompatible",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "422": {
            "description": "JSON inválido",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/monitor/stream": {
      "get": {
        "tags": ["monitor-controller"],
        "summary": "Ver MJPEG compartido sin crear inferencias por cliente",
        "operationId": "stream",
        "responses": {
          "429": {
            "description": "Máximo de conexiones de streaming alcanzado",
            "content": {
              "multipart/x-mixed-replace": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingResponseBody"
                }
              }
            }
          },
          "503": {
            "description": "Cámara no disponible",
            "content": {
              "multipart/x-mixed-replace": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingResponseBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/monitor/status": {
      "get": {
        "tags": ["monitor-controller"],
        "summary": "Consultar disponibilidad, modos y estado del JetMax",
        "operationId": "status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/monitor/snapshot": {
      "get": {
        "tags": ["monitor-controller"],
        "summary": "Consultar el snapshot coherente de cámara y proceso",
        "operationId": "snapshot",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorSnapshot"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/monitor/frame": {
      "get": {
        "tags": ["monitor-controller"],
        "summary": "Obtener el último JPEG procesado",
        "operationId": "frame",
        "responses": {
          "503": {
            "description": "Sin imagen disponible; Retry-After: 2",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    },
    "/api/v1/monitor/events": {
      "get": {
        "tags": ["monitor-controller"],
        "summary": "Suscribirse a snapshots SSE aproximadamente cada 100 ms",
        "operationId": "events",
        "responses": {
          "429": {
            "description": "Máximo de conexiones de streaming alcanzado",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamingResponseBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "VirtualCommand": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "pause|resume|cycle"
          }
        },
        "required": ["action"]
      },
      "Login": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 256,
            "minLength": 24
          }
        },
        "required": ["token"]
      },
      "PhysicalCommand": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "arm|cancel|reset|close-gripper|park"
          }
        },
        "required": ["action"]
      },
      "StreamingResponseBody": {},
      "Detection": {
        "type": "object",
        "properties": {
          "residue": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "pixel": {
            "$ref": "#/components/schemas/Point"
          },
          "offsetMm": {
            "$ref": "#/components/schemas/Point"
          },
          "targetMm": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "type": "string"
          }
        }
      },
      "Equipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "JointAngles": {
        "type": "object",
        "properties": {
          "joint1": {
            "type": "number",
            "format": "double"
          },
          "joint2": {
            "type": "number",
            "format": "double"
          },
          "joint3": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MonitorSnapshot": {
        "type": "object",
        "properties": {
          "experimentalMode": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceMode": {
            "type": "string"
          },
          "motionMode": {
            "type": "string"
          },
          "telemetryTransport": {
            "type": "string"
          },
          "robotState": {
            "$ref": "#/components/schemas/RobotState"
          },
          "cameraTransport": {
            "type": "string"
          },
          "simulationState": {
            "$ref": "#/components/schemas/SimulationState"
          },
          "detection": {
            "$ref": "#/components/schemas/Detection"
          },
          "targetDetection": {
            "$ref": "#/components/schemas/Detection"
          },
          "process": {
            "$ref": "#/components/schemas/ProcessState"
          },
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operation"
            }
          },
          "equipment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Equipment"
            }
          },
          "framesPerSecond": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "residue": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "format": "double"
          },
          "result": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "format": "int64"
          },
          "destination": {
            "type": "string"
          },
          "depositConfirmed": {
            "type": "boolean"
          }
        }
      },
      "Point": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ProcessState": {
        "type": "object",
        "properties": {
          "stageIndex": {
            "type": "integer",
            "format": "int32"
          },
          "elapsedMs": {
            "type": "integer",
            "format": "int64"
          },
          "stageElapsedMs": {
            "type": "integer",
            "format": "int64"
          },
          "stageDurationsMs": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "progressPercent": {
            "type": "number",
            "format": "double"
          },
          "completed": {
            "type": "boolean"
          },
          "lastResult": {
            "type": "string"
          },
          "gripperClosed": {
            "type": "boolean"
          }
        }
      },
      "ReportedPosition": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          },
          "z": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "RobotState": {
        "type": "object",
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "stepLabel": {
            "type": "string"
          },
          "autoEnabled": {
            "type": "boolean"
          },
          "cycleActive": {
            "type": "boolean"
          },
          "holdingObject": {
            "type": "boolean"
          },
          "completedGrasps": {
            "type": "integer",
            "format": "int64"
          },
          "reportedPosition": {
            "$ref": "#/components/schemas/ReportedPosition"
          },
          "gripperAngle": {
            "type": "number",
            "format": "double"
          },
          "reportedJoints": {
            "$ref": "#/components/schemas/JointAngles"
          },
          "telemetryAt": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          },
          "completedCycles": {
            "type": "integer",
            "format": "int64"
          },
          "provisionalDestinations": {
            "type": "boolean"
          }
        }
      },
      "SimulationState": {
        "type": "object",
        "properties": {
          "paused": {
            "type": "boolean"
          },
          "cycleActive": {
            "type": "boolean"
          },
          "stableFrames": {
            "type": "integer",
            "format": "int32"
          },
          "requiredStableFrames": {
            "type": "integer",
            "format": "int32"
          },
          "targetReady": {
            "type": "boolean"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "processedToday": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "successful": {
            "type": "integer",
            "format": "int64"
          },
          "failed": {
            "type": "integer",
            "format": "int64"
          },
          "averageDurationMs": {
            "type": "number",
            "format": "double"
          },
          "unverified": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "name": "rony_session",
        "in": "cookie"
      }
    }
  }
}
