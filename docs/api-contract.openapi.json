            "title": "Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["token"],
        "title": "Login"
      },
      "Operation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "completedAt": {
            "type": "string",
            "title": "Completedat"
          },
          "residue": {
            "type": "string",
            "title": "Residue"
          },
          "category": {
            "type": "string",
            "enum": ["plastic", "cardboard", "aluminum"],
            "title": "Category"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "result": {
            "type": "string",
            "enum": ["success", "failure"],
            "title": "Result"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Durationms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "completedAt",
          "residue",
          "category",
          "confidence",
          "result",
          "durationMs"
        ],
        "title": "Operation"
      },
      "PhysicalCommand": {
        "properties": {
          "action": {
            "type": "string",
            "enum": ["arm", "cancel", "reset"],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["action"],
        "title": "PhysicalCommand"
      },
      "Position": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["x", "y"],
        "title": "Position"
      },
      "Process": {
        "properties": {
          "stageIndex": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Stageindex"
          },
          "elapsedMs": {
            "type": "integer",
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Elapsedms"
          },
          "stageElapsedMs": {
            "type": "integer",
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Stageelapsedms"
          },
          "stageDurationsMs": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 6,
            "title": "Stagedurationsms"
          },
          "progressPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progresspercent"
          },
          "completed": {
            "type": "boolean",
            "title": "Completed"
          },
          "lastResult": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["success", "failure"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastresult"
          },
          "gripperClosed": {
            "type": "boolean",
            "title": "Gripperclosed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stageIndex",
          "elapsedMs",
          "stageElapsedMs",
          "stageDurationsMs",
          "progressPercent",
          "completed",
          "lastResult",
          "gripperClosed"
        ],
        "title": "Process"
      },
      "RobotPosition": {
        "properties": {
          "x": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "X"
          },
          "y": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": -1000000.0,
            "title": "Y"
          },
          "z": {
            "type": "number",
